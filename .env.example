# ---------------------------------------------------------------------------
# Woow LiteLLM MCP server — example environment
# Copy to `.env` and fill in. NEVER commit a real master key or JWT secret.
# ---------------------------------------------------------------------------

# === Component 1: the FastMCP server (env_prefix = LITELLM_MCP_) ============

# Base URL of the LiteLLM gateway. NO /api/v5 suffix, NO trailing slash needed.
# In-cluster:  http://litellm.litellm.svc.cluster.local:4000
# External:    https://litellm.woowtech.io
LITELLM_MCP_BASE_URL=http://localhost:4000

# LiteLLM master (or admin) key, sent as an `Authorization: Bearer` header.
# Placeholder only — supply the real value via a k8s Secret or your shell.
LITELLM_MCP_MASTER_KEY=sk-REPLACE_ME

# --- gating -----------------------------------------------------------------
# When true, every dangerous/mutating tool is dropped at registration time.
LITELLM_MCP_READONLY=false
# Comma-separated categories to disable entirely:
#   models,chat,keys,teams,users,spend,health,plugins
LITELLM_MCP_DISABLED_CATEGORIES=
# Comma-separated individual tool names to disable, e.g.:
#   litellm_delete_key,litellm_delete_team
LITELLM_MCP_DISABLED_TOOLS=
# Operation gates: comma-separated "tool:op" or bare "op" entries.
LITELLM_MCP_DISABLED_OPERATIONS=

# --- paging / limits --------------------------------------------------------
LITELLM_MCP_DEFAULT_LIMIT=50
LITELLM_MCP_MAX_LIMIT=500
LITELLM_MCP_REQUEST_TIMEOUT=60

# === Component 2/3: the admin console (mcp_admin_core) ======================

# Where the file-backed config store lives (plaintext, chmod 600).
MCP_ADMIN_CONFIG=/data/config.json

# JWT signing secret for the admin GUI. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random per-process secret is used (tokens won't survive restarts).
JWT_SECRET=REPLACE_WITH_RANDOM_HEX
JWT_EXPIRY_HOURS=24

# Kubernetes namespace label surfaced on the dashboard (informational only).
NAMESPACE=litellm-mcp
