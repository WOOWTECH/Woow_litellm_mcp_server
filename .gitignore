# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/
wheels/
.installed.cfg
pip-wheel-metadata/

# --- Virtualenvs ----------------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Test / coverage ------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# --- Secrets / runtime state ----------------------------------------------
# Secret patterns are anchored to the repo root (leading /) on purpose: an
# unanchored "config.json" or "secrets.yaml" also matches
# charts/litellm-mcp/templates/secrets.yaml and silently keeps a chart template
# out of git. The `!/charts/**` / `!/deploy/**` lines at the end of this file
# are the second belt, and CI fails if any chart file is ignored or untracked.
.env
.env.*
!.env.example
/config.json
/data/
/secrets.yaml
/*-secrets.yaml
/*.secret.yaml
/*secrets.values.yaml
/*.local.yaml
*.pem
*.key

# --- Node / frontend build ------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
static/
*.log

# --- Editor / OS ----------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- The chart is never ignored -------------------------------------------
# Nothing under charts/ or deploy/ may be excluded by any pattern above: a
# swallowed templates/secrets.yaml renders an install without its Secrets and
# nobody notices until the pod cannot start.
!/charts/**
!/deploy/**
